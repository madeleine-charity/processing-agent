# Leave empty to use your Claude Code login instead of the API
ANTHROPIC_API_KEY=
# Optional overrides
# CLAUDE_CODE_MODEL=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium
# AUTO_PUSH=1        # back up your sketches to a private GitHub repo (processing-sketches)
# AUTO_PUBLISH=1     # only if you've set up a gallery site (see README)
# GALLERY_DIR=../processing-gallery
# MAX_RUNS_PER_TURN=6
# SKETCH_TIMEOUT=60
# PROCESSING_APP=/Applications/Processing.app
# CLAUDE_BIN=          # path to claude, if it isn't on the PATH
# SKETCHES_DIR=./sketches
